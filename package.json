{
  "name": "dwarf-gym",
  "version": "0.3.0",
  "private": true,
  "description": "Pixel kettlebell swing game with front-camera onboarding",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node tools/serve.cjs dist",
    "dev:rowing": "node tools/serve.cjs reference/strumok/dist 4174",
